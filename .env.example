# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/kudu"
# Direct connection used for migrations (Neon: the non-pooled URL). Locally, same as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/kudu"

# Random secret for sessions. Generate with: npx auth secret
AUTH_SECRET=""

# First administrator of the original company (company code "kudu"). Used only for the very first sign-in, while no password users exist;
# that login creates the account. Afterwards, manage users in Settings → Users.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# Optional: first super-admin (creates companies at /platform). While no super-admin exists,
# this login creates one. If not set, ADMIN_EMAIL / ADMIN_PASSWORD are used.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Optional: Google OAuth client for "Sign in with Google" and Calendar sync (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: Google accounts allowed to sign in with Google (Kudu users are always allowed).
ALLOWED_EMAILS="you@example.com"

# Time zone used for dates, schedules and the calendar
APP_TIMEZONE="Africa/Johannesburg"

# Local development only: skip sign-in. Ignored in production builds.
AUTH_DISABLED="false"

# Optional: public address of the site, used for links in emails (unsubscribe, logo). Without it, the address in use when sending.
APP_URL=""

# Optional: email campaigns sent from each user's own mailbox (see README → Email campaigns).
# Gmail / Google Workspace: an OAuth client with the Gmail API and gmail.send scope (falls back to AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET).
GOOGLE_MAIL_CLIENT_ID=""
GOOGLE_MAIL_CLIENT_SECRET=""
# Outlook / Microsoft 365: a Microsoft Entra app registration with delegated Mail.Send, User.Read and offline_access.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

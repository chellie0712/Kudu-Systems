# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/kudu"
# Direct connection used for migrations (Neon: the non-pooled URL). Locally, same as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/kudu"

# Random secret for sessions. Generate with: npx auth secret
AUTH_SECRET=""

# First administrator. Used only for the very first sign-in, while no password users exist;
# that login creates the account. Afterwards, manage users in Settings → Users.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# Optional: Google OAuth client for "Sign in with Google" and Calendar sync (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: Google accounts allowed to sign in with Google (Kudu users are always allowed).
ALLOWED_EMAILS="you@example.com"

# Time zone used for dates, schedules and the calendar
APP_TIMEZONE="Africa/Johannesburg"

# Local development only: skip sign-in. Ignored in production builds.
AUTH_DISABLED="false"

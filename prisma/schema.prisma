// Kudu Systems CRM & BPA
// All money values are stored as integer cents to avoid rounding errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations. Neon's Vercel integration sets this.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Auth (Auth.js / NextAuth) ----------

// What a user may do: see src/lib/permissions.ts.
enum Role {
  ADMIN // everything, including settings and users
  OFFICE // customers, quotations, job cards, invoices, calendar
  TECHNICIAN // only the job cards assigned to them; no prices
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set for email + password sign-in
  disabled      Boolean   @default(false)
  role          Role      @default(OFFICE)
  jobCards      JobCard[] // job cards assigned to this user as technician
  labourRate    Int? // cents per hour excl. VAT; overrides Settings.labourRate when set
  timeEntries   TimeEntry[]
  vans          StockLocation[] // vans this user drives
  queries       Query[] // queries assigned to this user
  branchId      String? // home branch: the branch shown when they sign in
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  mailAccount   MailAccount? // the mailbox their email campaigns are sent from
  campaignsSent EmailCampaign[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Company settings (single row, id = 1) ----------

model Settings {
  id                 Int     @id @default(1)
  companyName        String  @default("Kudu Systems")
  tagline            String  @default("CRM & BPA Online System")
  email              String  @default("")
  phone              String  @default("")
  website            String  @default("")
  address            String  @default("")
  vatNumber          String  @default("")
  regNumber          String  @default("")
  currency           String  @default("ZAR")
  currencySymbol     String  @default("R")
  vatRate            Float   @default(15)
  bankName           String  @default("")
  bankAccountName    String  @default("")
  bankAccountNumber  String  @default("")
  bankBranchCode     String  @default("")
  quoteValidityDays  Int     @default(30)
  invoiceDueDays     Int     @default(30)
  quoteTerms         String  @default("This quotation is valid for the period stated. Prices include VAT where indicated.")
  invoiceTerms       String  @default("Payment is due by the due date shown. Please use the invoice number as your payment reference.")
  quotePrefix        String  @default("QT-")
  jobCardPrefix      String  @default("JC-")
  invoicePrefix      String  @default("INV-")
  nextQuoteNo        Int     @default(1)
  nextJobCardNo      Int     @default(1)
  nextInvoiceNo      Int     @default(1)
  queryPrefix        String  @default("QRY-")
  nextQueryNo        Int     @default(1)
  googleCalendarId   String  @default("primary")
  googleSyncUserId   String? // user whose Google account the calendar sync runs as
  googleSyncToken    String?
  // Google Ads: ad spend is pulled per campaign per day (see src/lib/googleAds.ts)
  googleAdsCustomerId    String    @default("") // the Ads account number, digits only
  googleAdsRefreshToken  String? // encrypted with AUTH_SECRET (src/lib/secret.ts)
  googleAdsAccountEmail  String    @default("") // Google account that connected it
  googleAdsCurrency      String    @default("")
  googleAdsLastSyncAt    DateTime?
  googleAdsLastError     String    @default("")
  // Accounting package link (src/lib/accounting). One package per company at a time;
  // its login/tokens and choices are in AccountingLink.
  accountingProvider     String    @default("") // "", sage, xero, quickbooks, zoho, freshbooks, odoo, pastel
  acctUseKuduNumbers     Boolean   @default(true) // the package's invoice number = Kudu's invoice number
  acctAutoSend           Boolean   @default(true) // send invoices and payments as soon as they are issued/recorded
  acctStartDate          DateTime? // only invoices issued from this day are sent (older ones are already in the package)
  acctLastError          String    @default("")
  acctLastSyncAt         DateTime?
  // Job card & service warranty
  jobCardTitle       String  @default("Job Card & Service Warranty")
  jobCardSubtitle    String  @default("Registered Pest Control Operator")
  pcoNumber          String  @default("")
  pcoSignature       String? @db.Text // PNG data URL printed in the PCO block
  logo               String? @db.Text // company logo as an image data URL, printed on documents
  // Quotation and invoice layouts (src/lib/docLayout.ts): one of classic, statement, modern, minimal, boxed
  quoteLayout        String  @default("classic")
  invoiceLayout      String  @default("classic")
  docStyle           Json    @default("{}") // colour, font, logo, columns and wording (DocStyle)
  warrantyMonths     Int     @default(3)
  // Labour billing
  labourRate         Int     @default(0) // cents per hour excl. VAT
  labourDescription  String  @default("Labour")
  labourRoundMinutes Int     @default(15) // billed time is rounded up to this many minutes
  // Invoice approval
  invoiceApproval          Boolean @default(false) // invoices must be approved before they can be sent
  invoiceApprovalThreshold Int     @default(0) // cents incl. VAT; only invoices of at least this total need approval
  warrantyCovers     String  @default("General Pest Control\nTermites / WDI\nRodents\nFumigation\nOther") // one option per line
  warrantyTerms      String  @default("Covers re-treatment of the pest species and areas listed above, if activity recurs under normal conditions; a follow-up fee is applicable.\nExcludes new infestations by a different pest, and conditions beyond our control (alterations, water damage, etc.).\nNotify us in writing within 14 days of any recurring activity to remain covered under this warranty.\nVoid if unauthorised pest control products or other contractors are used in the treated area.\nReasonable access must be given for re-treatment visits; failure to do so may void cover for that area.\nNon-transferable — applies only to the client and property named above.") // one term per line
}

// Registered products offered on the job card's Active Ingredients list.
model Product {
  id               String  @id @default(cuid())
  name             String
  activeIngredient String  @default("")
  regNumber        String  @default("")
  active           Boolean @default(true)
  sortOrder        Int     @default(0)
}

// ---------- Customers ----------

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

model Customer {
  id              String          @id @default(cuid())
  type            CustomerType    @default(BUSINESS)
  name            String // display name: company name or person's full name
  // Copy of the primary contact (CustomerContact.isPrimary), kept in step by src/lib/contacts.ts.
  // Accounting sync, email campaigns and the portal read these.
  contactPerson   String          @default("")
  email           String          @default("")
  phone           String          @default("")
  altPhone        String          @default("")
  contacts        CustomerContact[]
  vatNumber       String          @default("")
  regNumber       String          @default("")
  billingAddress  String          @default("")
  siteAddress     String          @default("")
  notes           String          @default("")
  archived        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  quotations      Quotation[]
  jobCards        JobCard[]
  invoices        Invoice[]
  events          CalendarEvent[]
  assets          CustomerAsset[]
  queries         Query[]
  portalUsers     PortalUser[] // the customer's logins to the customer portal
  leadSource      String          @default("") // how they found us, e.g. "Google Ads" (see src/lib/marketing.ts)
  leadCampaign    String          @default("") // the ad campaign, matched to AdSpend.campaign
  acctLink        String          @default("") // "provider:organisation" the acctId belongs to
  acctId          String? // the customer's ID (Pastel: account code) in the accounting package
  branchId        String? // the branch that looks after this customer; its documents follow it
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // Email marketing consent (POPIA section 69); see src/lib/email/audience.ts
  emailConsent       EmailConsent     @default(UNKNOWN)
  emailConsentAt     DateTime?
  emailConsentSource String           @default("") // e.g. "Unsubscribe link in 'Winter special'"
  emailRecipients    EmailRecipient[]

  @@index([branchId])
}

/// A person at the customer. Exactly one is primary when the customer has any contacts;
/// documents default to it. Archived contacts are hidden from pickers but still print on old documents.
model CustomerContact {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String      @default("")
  role       String      @default("") // job title / role, e.g. "Facilities manager", "Accounts"
  email      String      @default("")
  phone      String      @default("")
  mobile     String      @default("") // the customer's "Alternative phone" for the primary contact
  notes      String      @default("")
  isPrimary  Boolean     @default(false)
  archived   Boolean     @default(false)
  quotations Quotation[]
  jobCards   JobCard[]
  invoices   Invoice[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([customerId])
}

// ---------- Quotations ----------

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quotation {
  id          String          @id @default(cuid())
  number      String          @unique
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactId   String? // the customer contact the document is for; prints instead of the primary contact
  contact     CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status      QuotationStatus @default(DRAFT)
  title       String          @default("")
  issueDate   DateTime        @default(now())
  validUntil  DateTime
  siteAddress String          @default("")
  notes       String          @default("")
  terms       String          @default("")
  vatRate     Float           @default(15)
  discount    Int             @default(0) // cents, before VAT
  subtotal    Int             @default(0)
  vatAmount   Int             @default(0)
  total       Int             @default(0)
  items       QuotationItem[]
  jobCards    JobCard[]
  invoices    Invoice[]
  // Answer given by the customer in the customer portal
  response     String          @default("") // "ACCEPTED" or "DECLINED"
  respondedAt  DateTime?
  respondedBy  String          @default("")
  responseNote String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)
  description String
  quantity    Float     @default(1)
  unit        String    @default("")
  unitPrice   Int       @default(0) // cents, excl. VAT
}

// ---------- Job Cards (Job Card & Service Warranty) ----------

enum JobCardStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model JobCard {
  id                    String          @id @default(cuid())
  number                String          @unique
  customerId            String
  customer              Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactId             String? // the customer contact for this job; fills site contact and number
  contact               CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  quotationId           String?
  quotation             Quotation?      @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  status                JobCardStatus   @default(SCHEDULED) // the stage; drives calendar, dashboard and filters
  statusId              String? // optional custom status shown instead of the stage name
  customStatus          JobStatus?      @relation(fields: [statusId], references: [id], onDelete: SetNull)
  // 1. Job details
  jobDate               DateTime?
  technician            String          @default("") // name printed on the job card
  technicianId          String? // user the job is assigned to (technicians see only their own jobs)
  technicianUser        User?           @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  jobType               String          @default("")
  priority              String          @default("Normal")
  scheduledStart        DateTime?
  scheduledEnd          DateTime?
  scopeOfWork           String          @default("") // instructions, pre-filled from the quotation
  // 2. Client details (site-specific; defaults from the customer)
  contactNumber         String          @default("")
  siteContact           String          @default("")
  siteAddress           String          @default("")
  // 3. Work performed
  areaTreated           String          @default("")
  workDescription       String          @default("")
  // 5. Warranty
  warrantyNo            String          @default("")
  warrantyStart         DateTime?
  warrantyEnd           DateTime?
  warrantyCovers        String[]        @default([])
  activeIngredients     String[]        @default([]) // snapshot of product labels at time of job
  activeIngredientOther String          @default("")
  warrantyComments      String          @default("")
  // 7. Client sign-off
  clientConfirmed       Boolean         @default(false)
  customerSignName      String          @default("")
  customerSignature     String?         @db.Text // PNG data URL
  signedAt              DateTime?
  photos                JobCardPhoto[]
  checklists            JobCardChecklist[]
  timeEntries           TimeEntry[]
  stockMovements        StockMovement[]
  assetChecks           AssetCheck[]
  queries               Query[] // queries this job card was raised for (e.g. a re-service)
  customerRating        Int? // 1-5 stars given by the client at sign-off
  customerFeedback      String          @default("") // the client's comment at sign-off
  invoices              Invoice[]
  events                CalendarEvent[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([technicianId])
}

// Company-defined job statuses, e.g. "Awaiting parts". Each belongs to one stage
// (Scheduled, In progress, Completed, Cancelled), which the rest of the system uses.
model JobStatus {
  id        String        @id @default(cuid())
  name      String
  colour    String        @default("slate") // one of the colour keys in src/lib/jobStatus.ts
  stage     JobCardStatus @default(IN_PROGRESS)
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  jobCards  JobCard[]
}

// Checklist / form templates set up in Settings and filled in on job cards.
model ChecklistTemplate {
  id                    String             @id @default(cuid())
  name                  String
  items                 String             @default("") // one item per line
  autoAddAll            Boolean            @default(false) // add to every job card
  jobType               String             @default("") // or: add to job cards of this job type
  requiredForCompletion Boolean            @default(false) // all items ticked before the job can be Completed
  active                Boolean            @default(true)
  sortOrder             Int                @default(0)
  checklists            JobCardChecklist[]
}

// A checklist on one job card. Items are copied from the template, so editing a template never changes past jobs.
model JobCardChecklist {
  id                    String             @id @default(cuid())
  jobCardId             String
  jobCard               JobCard            @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  templateId            String?
  template              ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name                  String
  requiredForCompletion Boolean            @default(false)
  items                 Json               @default("[]") // [{ label, done, note }]
  sortOrder             Int                @default(0)

  @@index([jobCardId])
}

// Time worked on a job: a running timer (end is null) or a finished entry.
model TimeEntry {
  id        String    @id @default(cuid())
  jobCardId String
  jobCard   JobCard   @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String    @default("") // kept if the user is later removed
  start     DateTime
  end       DateTime?
  note      String    @default("")
  billable  Boolean   @default(true)
  invoiceId String? // set once the time is billed
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([jobCardId])
  @@index([userId, end])
}

// ---------- Inventory ----------

model StockItem {
  id           String          @id @default(cuid())
  name         String
  sku          String          @default("")
  unit         String          @default("each") // e.g. each, ml, L, g, kg
  costPrice    Int             @default(0) // cents per unit excl. VAT
  sellPrice    Int             @default(0) // cents per unit excl. VAT, used when billing materials
  reorderLevel Float           @default(0) // warn when the total on hand drops to this
  notes        String          @default("")
  active       Boolean         @default(true)
  levels       StockLevel[]
  movements    StockMovement[]
  createdAt    DateTime        @default(now())
}

enum StockLocationType {
  WAREHOUSE
  VAN
}

model StockLocation {
  id       String            @id @default(cuid())
  name     String
  type     StockLocationType @default(WAREHOUSE)
  userId   String? // the technician who drives this van
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  active   Boolean           @default(true)
  levels   StockLevel[]
  movesOut StockMovement[]   @relation("from")
  movesIn  StockMovement[]   @relation("to")
}

model StockLevel {
  itemId     String
  item       StockItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Float         @default(0)

  @@id([itemId, locationId])
}

enum StockMovementKind {
  RECEIVE // into a location (from a supplier)
  TRANSFER // between locations, e.g. warehouse to van
  USE // used on a job, out of a location
  ADJUST // stock count correction
}

model StockMovement {
  id             String            @id @default(cuid())
  itemId         String
  item           StockItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind           StockMovementKind
  fromLocationId String?
  fromLocation   StockLocation?    @relation("from", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId   String?
  toLocation     StockLocation?    @relation("to", fields: [toLocationId], references: [id], onDelete: SetNull)
  quantity       Float // always positive; ADJUST stores the change (+/-)
  jobCardId      String?
  jobCard        JobCard?          @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  invoiceId      String? // set once the material is billed
  invoice        Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  note           String            @default("")
  userId         String? // who recorded it (no relation, so removing a user keeps history)
  userName       String            @default("")
  createdAt      DateTime          @default(now())

  @@index([itemId, createdAt])
  @@index([jobCardId])
}

enum PhotoKind {
  BEFORE
  AFTER
  EXTRA
}

// Photos are uploaded one at a time (keeps each request small) and attached when the job card is saved.
model JobCardPhoto {
  id        String    @id @default(cuid())
  jobCardId String?
  jobCard   JobCard?  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  kind      PhotoKind @default(EXTRA)
  sortOrder Int       @default(0)
  dataUrl   String    @db.Text // compressed JPEG data URL
  createdAt DateTime  @default(now())
}

// ---------- Invoices ----------

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// The company's login to an accounting package and its choices (tax types, accounts...).
/// One row per package, so switching back keeps the earlier setup.
model AccountingLink {
  provider    String   @id
  credentials String? // JSON, encrypted with AUTH_SECRET: tokens, password or API key
  orgId       String   @default("") // organisation/company/tenant in the package
  orgName     String   @default("")
  config      Json     @default("{}") // picker values, see each adapter's pickers()
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactId   String? // the customer contact the document is for; prints instead of the primary contact
  contact     CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  quotationId String?
  quotation   Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  jobCardId   String?
  jobCard     JobCard?      @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  reference   String        @default("") // customer order number etc.
  notes       String        @default("")
  terms       String        @default("")
  vatRate     Float         @default(15)
  discount    Int           @default(0)
  subtotal    Int           @default(0)
  vatAmount   Int           @default(0)
  total       Int           @default(0)
  amountPaid  Int           @default(0)
  // Approval (see Settings → Invoice approval)
  approvalRequestedAt DateTime?
  approvalRequestedBy String    @default("")
  approvedAt          DateTime?
  approvedBy          String    @default("")
  approvalNote        String    @default("") // reason given when sent back
  items       InvoiceItem[]
  payments    Payment[]
  timeEntries TimeEntry[] // labour billed on this invoice
  stockMovements      StockMovement[] // materials billed on this invoice
  acctLink        String    @default("") // "provider:organisation" the acctId belongs to
  acctId          String? // the invoice's ID in the accounting package, once sent (or exported)
  acctNumber      String    @default("")
  acctSentAt      DateTime?
  acctHash        String    @default("") // fingerprint of what was sent, to resend only real changes
  acctCheckedAt   DateTime? // last time the package was asked for payments on it
  acctError       String    @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([acctLink, acctId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  description String
  quantity    Float   @default(1)
  unit        String  @default("")
  unitPrice   Int     @default(0)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Int
  date      DateTime @default(now())
  method    String   @default("EFT")
  reference String   @default("")
  acctLink  String   @default("") // "provider:organisation" the acctId belongs to
  acctId    String? // the payment's ID in the accounting package, once sent (or the import key)
  fromAccounting Boolean @default(false) // captured in the accounting package and brought into Kudu (never sent back)
  acctError String   @default("")
  createdAt DateTime @default(now())
}

// ---------- Calendar ----------

model CalendarEvent {
  id               String    @id @default(cuid())
  title            String
  description      String    @default("")
  location         String    @default("")
  start            DateTime
  end              DateTime
  allDay           Boolean   @default(false)
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobCardId        String?
  jobCard          JobCard?  @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  googleEventId    String?   @unique
  googleCalendarId String?
  googleUpdatedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ---------- Customer assets ----------

/** Equipment at a customer's site that is serviced on visits, e.g. bait stations, fly units, traps. */
model CustomerAsset {
  id            String       @id @default(cuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  code          String       @default("") // tag or station number, e.g. BS-01
  name          String // e.g. Bait station, Fly unit, Rodent trap
  location      String       @default("") // where on site
  serialNumber  String       @default("")
  installedAt   DateTime?
  serviceMonths Int          @default(0) // service interval; 0 = none
  notes         String       @default("")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  checks        AssetCheck[]

  @@index([customerId])
}

/** What was found or done to an asset on a job card. */
model AssetCheck {
  id         String        @id @default(cuid())
  assetId    String
  asset      CustomerAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  jobCardId  String
  jobCard    JobCard       @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  result     String // one of ASSET_RESULTS
  note       String        @default("")
  userName   String        @default("")
  checkedAt  DateTime      @default(now())

  @@unique([assetId, jobCardId])
  @@index([jobCardId])
}

// ---------- Branches ----------

/** An office of the company. Customers belong to a branch; lists and the dashboard can be filtered by it. */
model Branch {
  id        String     @id @default(cuid())
  name      String
  address   String     @default("")
  phone     String     @default("")
  email     String     @default("")
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  customers Customer[]
  users     User[]
  createdAt DateTime   @default(now())
}

// ---------- Customer queries ----------

enum QueryStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum QueryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/** A customer query, complaint or request, tracked until resolved. */
model Query {
  id           String        @id @default(cuid())
  number       String        @unique
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subject      String
  description  String        @default("")
  category     String        @default("") // e.g. Complaint, Re-service request, Billing
  source       String        @default("") // e.g. Phone, Email, WhatsApp
  priority     QueryPriority @default(NORMAL)
  status       QueryStatus   @default(OPEN)
  assignedToId String?
  assignedTo   User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  dueAt        DateTime?
  jobCardId    String? // the job card raised to deal with it, or the job it is about
  jobCard      JobCard?      @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  resolution   String        @default("")
  resolvedAt   DateTime?
  createdBy    String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  notes        QueryNote[]

  @@index([status])
  @@index([customerId])
}

/** Timeline entry on a query: a note, or a recorded change (status, assignment). */
model QueryNote {
  id        String   @id @default(cuid())
  queryId   String
  query     Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
  text      String
  system    Boolean  @default(false) // true for automatic entries like "Status: Open → Resolved"
  userName  String   @default("")
  createdAt DateTime @default(now())

  @@index([queryId, createdAt])
}

/// A customer's login to the customer portal. Kept apart from staff users so a portal
/// session can never reach the staff side.
model PortalUser {
  id              String    @id @default(cuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name            String    @default("")
  email           String    @unique
  passwordHash    String?
  inviteToken     String?   @unique // one-time link to set a password; cleared once used
  inviteExpiresAt DateTime?
  disabled        Boolean   @default(false)
  lastLoginAt     DateTime?
  createdBy       String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
}

/// Advertising cost per campaign per day, pulled from Google Ads (or entered by hand for other channels).
model AdSpend {
  id          String   @id @default(cuid())
  date        DateTime // the day, at 00:00 UTC
  channel     String   @default("Google Ads")
  campaignId  String // Google's campaign id; for hand-entered spend, the campaign name
  campaign    String
  cost        Int      @default(0) // cents, as charged by the channel (excl. VAT)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  conversions Float    @default(0) // the channel's own conversion count (form fills, calls)
  updatedAt   DateTime @updatedAt

  @@unique([channel, campaignId, date])
  @@index([date])
}

/// A business cost for the profit & loss report: wages, fuel, rent, chemicals bought, other advertising…
model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  category    String
  description String   @default("")
  supplier    String   @default("")
  amount      Int // cents excl. VAT
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

// ---------- Email marketing ----------

/**
 * POPIA s69: marketing email needs consent, except to an existing customer (someone we sold to)
 * about our own similar services, who may opt out in every email.
 */
enum EmailConsent {
  UNKNOWN // not asked: emailed only while they are an existing customer (has an issued invoice)
  OPTED_IN // gave consent to receive marketing email
  UNSUBSCRIBED // opted out: never sent marketing email again
}

enum MailProvider {
  GOOGLE // Gmail / Google Workspace, through the Gmail API
  MICROSOFT // Outlook / Microsoft 365, through Microsoft Graph
  SMTP // any other mailbox, with its SMTP server details
}

/**
 * A user's own mailbox. Campaigns they send go out from it, from their sign-in email address.
 */
model MailAccount {
  id         String       @id @default(cuid())
  userId     String       @unique
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   MailProvider
  email      String // the address mail is sent from (always the user's sign-in email)
  fromName   String       @default("")
  secret     String       @db.Text // encrypted (src/lib/secret.ts): refresh token, or SMTP password
  smtpHost   String       @default("")
  smtpPort   Int          @default(587)
  smtpSecure Boolean      @default(false) // true: TLS from the start (usually port 465); false: STARTTLS
  smtpUser   String       @default("")
  dailyLimit Int          @default(400) // campaign emails per day from this mailbox
  lastError  String       @default("")
  lastUsedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

enum CampaignStatus {
  DRAFT
  SENDING // queued recipients are being sent (also while waiting for the next day's limit)
  PAUSED // stopped by a person, or because the mailbox needs reconnecting
  SENT
  CANCELLED
}

model EmailCampaign {
  id             String           @id @default(cuid())
  name           String // internal name
  subject        String           @default("")
  preheader      String           @default("") // the grey preview line inboxes show after the subject
  body           String           @default("") @db.Text // plain text with light formatting (src/lib/email/render.ts)
  buttonLabel    String           @default("")
  buttonUrl      String           @default("")
  // Audience: who is eligible is decided by consent (src/lib/email/audience.ts); these narrow it.
  audBranchId    String?
  audType        String           @default("") // "", BUSINESS, INDIVIDUAL
  audLeadSource  String           @default("")
  audOptedInOnly Boolean          @default(false)
  status         CampaignStatus   @default(DRAFT)
  senderId       String? // whose mailbox it goes out from; set when sending starts
  sender         User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  baseUrl        String           @default("") // site address for unsubscribe links, saved when sending starts
  pausedReason   String           @default("")
  createdByName  String           @default("")
  startedAt      DateTime?
  finishedAt     DateTime?
  recipients     EmailRecipient[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

enum RecipientStatus {
  QUEUED
  SENDING // claimed by a sender right now
  SENT
  FAILED
  SKIPPED // unsubscribed or no longer eligible by the time their turn came
}

model EmailRecipient {
  id             String          @id @default(cuid())
  campaignId     String
  campaign       EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email          String
  name           String          @default("")
  status         RecipientStatus @default(QUEUED)
  error          String          @default("")
  claimedAt      DateTime?
  sentAt         DateTime?
  unsubscribedAt DateTime?

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([sentAt])
}
